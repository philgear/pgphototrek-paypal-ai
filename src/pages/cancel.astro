---
// SPDX-License-Identifier: Apache-2.0
import StoreLayout from '../layouts/StoreLayout.astro';

const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
---

<StoreLayout
  title="Checkout Paused — Phil Gear Fine Art Atelier"
  description="Your staged room configuration is preserved. Return anytime to adjust dimensions, framing, or complete PayPal checkout."
>
  <section class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="rounded-2xl border border-slate-700 bg-slate-900/90 p-8 text-center shadow-2xl">
      <div class="size-14 rounded-full bg-amber-500/15 border border-amber-400/40 text-amber-300 flex items-center justify-center text-2xl mx-auto mb-4">
        <i class="fas fa-pause"></i>
      </div>
      <h1 class="font-pocketgull text-2xl sm:text-3xl font-black text-white mb-2">
        PayPal Checkout Paused
      </h1>
      <p class="text-slate-300 text-sm leading-relaxed mb-6">
        No charges were captured. Your 1:10 room visualizer selection, wall paint calibration, and custom framing options remain ready in the studio.
      </p>
      <a
        href={`${base}`}
        class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-[#0070BA] hover:bg-[#005ea6] text-white font-mono text-xs font-bold uppercase tracking-wider transition-all"
      >
        <i class="fas fa-arrow-left"></i>
        <span>Return to Room Visualizer & Store</span>
      </a>
    </div>
  </section>
</StoreLayout>
