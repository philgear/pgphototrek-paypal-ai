---
// SPDX-License-Identifier: Apache-2.0
import Layout from '../layouts/StoreLayout.astro';
import catalogData from '../data/store-catalog.json';

const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const withBase = (src: string) => `${base}${src.replace(/^\//, '')}`;

const allPhotos = catalogData;
const showcaseSelects = allPhotos.slice(0, 18);

const pnwWallPaints = [
  { brand: 'Rodda', code: 'CA002', name: 'Alabaster Fog', hex: '#E8E7E0' },
  { brand: 'Miller', code: 'MW001', name: 'Museum White', hex: '#F7F6F1' },
  { brand: 'Miller', code: 'JLS04', name: 'Warm Linen', hex: '#EFECE6' },
  { brand: 'Rodda', code: 'CA184', name: 'Pebble Gray', hex: '#BFC2BE' },
  { brand: 'Miller', code: 'NW045', name: 'Puget Navy', hex: '#1B243B' },
  { brand: 'Rodda', code: 'CA092', name: 'Cascade Fir', hex: '#1E3527' },
  { brand: 'Miller', code: 'H0010', name: 'Terracotta', hex: '#B85B38' },
  { brand: 'Rodda', code: 'CA223', name: 'Sunstone', hex: '#D6A874' },
  { brand: 'Miller', code: 'NW010', name: 'Obsidian', hex: '#1A1B1E' },
];

const substrates = [
  {
    id: 'giclee',
    shortName: 'Cotton Rag',
    name: 'Hahnemühle Photo Rag 308g (Fine Art Giclée)',
    desc: '100% cotton museum rag with tactile matte finish (included).',
    priceMultiplier: 1.0,
  },
  {
    id: 'metal',
    shortName: 'Brushed Metal',
    name: 'ChromaLuxe Brushed Aluminum',
    desc: 'Ready-to-hang aluminum panel with luminous satin sheen.',
    priceMultiplier: 1.25,
  },
  {
    id: 'acrylic',
    shortName: 'Gallery Acrylic',
    name: 'UltraHD Borderless Acrylic Glass',
    desc: 'Museum-grade 4mm optical acrylic face-mount.',
    priceMultiplier: 1.4,
  },
];

const beardsFramingProfiles = [
  {
    id: 'float',
    shortName: 'Float Mount',
    name: 'Borderless Gallery Float Mount',
    desc: 'Arrives ready to hang with a hidden recessed wall cleat.',
    addonPrice: 0,
    frameBorder: '#1c1917',
    frameWidth: '2px',
    matBg: '#0c0a09',
    matPad: '2px',
  },
  {
    id: 'beards-black',
    shortName: 'Satin Black',
    name: "Beard's Framing Satin Black + 4-Ply Rag Mat",
    desc: 'Satin black hardwood frame with 4-ply cotton mat.',
    addonPrice: 140,
    frameBorder: '#18181b',
    frameWidth: '10px',
    matBg: '#f5f4ee',
    matPad: '14px',
  },
  {
    id: 'beards-walnut',
    shortName: 'Black Walnut',
    name: "Beard's Cascade Black Walnut + 8-Ply Museum Mat",
    desc: 'Solid Pacific Northwest Black Walnut with 8-ply rag mat.',
    addonPrice: 220,
    frameBorder: '#3d2314',
    frameWidth: '12px',
    matBg: '#f4f1ea',
    matPad: '18px',
  },
  {
    id: 'beards-kells',
    shortName: 'Kinpaku Gold',
    name: "Beard's Gilded Kells Bronze + Archival Linen Mat",
    desc: '24k gold-leaf bevel paired with an archival linen mat.',
    addonPrice: 260,
    frameBorder: '#b45309',
    frameWidth: '12px',
    matBg: '#efeadd',
    matPad: '18px',
  },
  {
    id: 'pdx-wlf-luminescent',
    shortName: 'Edge-Lit Halo',
    name: 'PDX Winter Light Festival Edge-Lit Luminescent Frame',
    desc: 'Warm 2700K illuminated optical halo frame.',
    addonPrice: 185,
    frameBorder: '#f59e0b',
    frameWidth: '9px',
    matBg: '#090d16',
    matPad: '12px',
  },
  {
    id: 'goodwill-upcycle',
    shortName: 'Vintage Upcycle',
    name: 'Goodwill Vintage Rescue & Archival Upcycle Frame',
    desc: 'Restored vintage Portland frame with archival backing.',
    addonPrice: 45,
    frameBorder: '#78350f',
    frameWidth: '11px',
    matBg: '#efe8d8',
    matPad: '16px',
  },
];

const portlandFulfillmentModes = [
  {
    id: 'pdx-dropship',
    shortName: 'Free Shipping',
    name: 'Portland Fine Art Lab Direct Dropship',
    desc: 'Insured flat-crate shipping direct to your door.',
    priceDelta: 0,
  },
  {
    id: 'beards-willcall',
    shortName: 'PDX Pickup (−$45)',
    name: "Beard's Framing Studio Will-Call (PDX Metro)",
    desc: "Pick up locally in Portland or Lake Oswego and save $45.",
    priceDelta: -45,
  },
  {
    id: 'jls-closing-gift',
    shortName: 'Closing Gift (−$50)',
    name: 'John L. Scott Real Estate Staging & Closing Gift',
    desc: 'Includes gift card & matched wall paint swatch (−$50 credit).',
    priceDelta: -50,
  },
  {
    id: 'pdx-courier',
    shortName: 'PDX Courier',
    name: 'Local Portland White-Glove Courier',
    desc: 'Hand-delivered ready-to-hang across Portland metro.',
    priceDelta: 0,
  },
  {
    id: 'goodwill-expedition',
    shortName: 'Upcycle (−$35)',
    name: 'Circular Upcycle Frame Expedition + Local Handoff',
    desc: 'Local handoff for rescued vintage frame editions (−$35).',
    priceDelta: -35,
  },
];
---

<Layout>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-10 space-y-10">
    <!-- Minimal Kinpaku Hero + Single-Input AI Room Matcher -->
    <section id="ai-concierge-panel" class="max-w-2xl mx-auto text-center space-y-4">
      <h1 class="font-kinpaku text-3xl sm:text-5xl tracking-tight leading-tight">
        Fine Art Prints, Sized for Your Space
      </h1>

      <div class="flex flex-col sm:flex-row gap-2 pt-1">
        <input
          id="ai-concierge-input"
          type="text"
          placeholder="Describe your room or budget (e.g., Calm ocean print for an office under $750)…"
          class="flex-1 bg-slate-900 border border-slate-800 focus:border-amber-400 rounded-xl px-4 py-3 text-sm text-white placeholder:text-slate-500 focus:outline-none"
        />
        <button
          id="ai-concierge-submit-btn"
          type="button"
          class="px-5 py-3 rounded-xl text-xs font-bold bg-amber-400 hover:bg-amber-300 text-slate-950 cursor-pointer transition-colors flex items-center justify-center gap-2 shrink-0"
        >
          <i class="fas fa-wand-magic-sparkles"></i>
          <span>Match My Room</span>
        </button>
      </div>

      <!-- Hidden quick chips preserved only if clicked via tests/agents, plus 2 quiet links -->
      <div class="flex items-center justify-center gap-2 flex-wrap text-xs text-slate-400">
        <button
          type="button"
          class="ai-prompt-chip hover:text-amber-300 underline underline-offset-4 cursor-pointer"
          data-prompt="Calm water print for a navy office under $750"
        >
          Office under $750
        </button>
        <span>·</span>
        <button
          type="button"
          class="ai-prompt-chip hover:text-amber-300 underline underline-offset-4 cursor-pointer"
          data-prompt="Misty Pacific Northwest forest with black walnut frame for a living room"
        >
          Walnut living room
        </button>
        <span>·</span>
        <button
          type="button"
          class="ai-prompt-chip hover:text-amber-300 underline underline-offset-4 cursor-pointer"
          data-prompt="Botanical print in a vintage frame under $450"
        >
          Gift under $450
        </button>
      </div>

      <div
        id="ai-concierge-result"
        class="hidden rounded-xl bg-slate-900 border border-amber-400/30 p-3.5 text-left space-y-1 text-xs"
      >
        <div class="flex items-center justify-between gap-2">
          <span class="text-amber-300 font-semibold">Staged for your space</span>
          <span id="ai-concierge-engine-badge" class="text-slate-400 text-[11px]"></span>
        </div>
        <p id="ai-concierge-rationale" class="text-slate-300 leading-relaxed"></p>
      </div>
    </section>

    <!-- Clean 2-Column Storefront: Wall Preview (Left) + 2-Step Checkout (Right) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left 7 Columns: Clean Wall Preview + Quiet Swatches -->
      <div class="lg:col-span-7 space-y-3">
        <div
          id="virtual-room-wall"
          class="relative rounded-2xl p-6 sm:p-10 transition-colors duration-500 flex flex-col items-center justify-between min-h-104 sm:min-h-120 border border-slate-800/80 overflow-hidden"
          style="background-color: #E8E7E0;"
        >
          <div
            id="wall-texture-overlay"
            class="absolute inset-0 pointer-events-none opacity-25 mix-blend-overlay"
            style="background-image: radial-gradient(rgba(0,0,0,0.08) 1px, transparent 0); background-size: 4px 4px;"
          ></div>
          <div
            id="wall-lighting-overlay"
            class="absolute inset-0 pointer-events-none"
            style="background: radial-gradient(ellipse at 50% 0%, rgba(255,255,255,0.28) 0%, rgba(0,0,0,0.22) 100%);"
          ></div>

          <!-- Quiet Top Bar: Wall Color Dots + Room Scene -->
          <div class="w-full flex items-center justify-between gap-2 relative z-10">
            <div class="flex items-center gap-1.5 bg-black/60 backdrop-blur-xs px-2.5 py-1.5 rounded-full">
              {pnwWallPaints.slice(0, 5).map((sw, idx) => (
                <button
                  type="button"
                  title={sw.name}
                  class={`paint-swatch-btn size-4 rounded-full border border-white/40 cursor-pointer transition-transform ${idx === 0 ? 'ring-2 ring-amber-400 scale-110' : ''}`}
                  style={`background-color: ${sw.hex};`}
                  data-hex={sw.hex}
                  data-brand={sw.brand}
                  data-code={sw.code}
                  data-name={sw.name}
                ></button>
              ))}
              <span id="active-wall-paint-label" class="sr-only">Alabaster Fog</span>
            </div>

            <div class="flex items-center gap-1 bg-black/60 backdrop-blur-xs p-1 rounded-full">
              <button type="button" class="room-btn px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-amber-400 text-slate-950 cursor-pointer" data-room="living">
                Living
              </button>
              <button type="button" class="room-btn px-2.5 py-0.5 rounded-full text-[11px] text-slate-200 hover:text-white cursor-pointer" data-room="office">
                Office
              </button>
              <button type="button" class="room-btn px-2.5 py-0.5 rounded-full text-[11px] text-slate-200 hover:text-white cursor-pointer" data-room="hearth">
                Hearth
              </button>
              <button type="button" class="room-btn px-2.5 py-0.5 rounded-full text-[11px] text-slate-200 hover:text-white cursor-pointer" data-room="gallery">
                Gallery
              </button>
              <button type="button" class="room-btn hidden" data-room="pavilion">Pavilion</button>
            </div>
          </div>

          <!-- Artwork Frame -->
          <div
            id="artwork-mounting-frame-wrapper"
            class="relative z-10 transition-all duration-500 ease-out flex items-center justify-center my-4"
          >
            <div id="gnome-left" class="hidden"></div>
            <div id="gnome-right" class="hidden"></div>
            <div
              id="artwork-mounting-frame"
              class="relative z-10 shadow-[0_24px_50px_rgba(0,0,0,0.6)] border-2 border-stone-950 bg-stone-900 flex items-center justify-center transition-all duration-300 p-1 max-w-[82%] max-h-84 overflow-hidden"
            >
              <img
                id="active-wall-artwork"
                src={withBase(showcaseSelects[0]?.src || '/images/vault/v2_ingest_192_laurelhurst.webp')}
                alt={showcaseSelects[0]?.title || 'Fine Art Print'}
                class="max-h-64 sm:max-h-72 w-auto h-auto max-w-full object-contain block select-none transition-opacity duration-300"
              />
            </div>
          </div>

          <div id="fairy-sparkles" class="hidden"></div>

          <!-- Minimal 1:10 Scale Credenza Reference -->
          <div class="w-full max-w-sm mt-2 flex flex-col items-center relative z-10">
            <div class="hidden">
              <div id="prop-skateboard"></div>
              <div id="prop-plant"></div>
              <div id="prop-workstation"></div>
              <div id="prop-sculpture"></div>
              <div id="prop-hearth-vessels"></div>
            </div>

            <div id="silhouette-living" class="w-full flex flex-col items-center">
              <div class="timber-surface w-full h-4 rounded-t-lg" style="background: linear-gradient(180deg, #3d2314 0%, #2b170c 100%);"></div>
              <div class="timber-body w-[92%] h-8 rounded-b-lg" style="background: linear-gradient(180deg, #2b170c 0%, #170b05 100%);"></div>
            </div>
            <div id="silhouette-hearth" class="hidden w-full flex-col items-center">
              <div class="timber-surface w-full h-4 rounded-md" style="background: linear-gradient(180deg, #3d2314 0%, #2b170c 100%);"></div>
              <div class="w-[80%] h-9 rounded-b-md bg-stone-950"></div>
            </div>
            <div id="silhouette-office" class="hidden w-full flex-col items-center">
              <div class="timber-surface w-full h-3 rounded-t-md" style="background: linear-gradient(180deg, #475569 0%, #1e293b 100%);"></div>
              <div class="w-[84%] h-9 flex justify-between px-4">
                <div class="w-1.5 h-full bg-slate-600"></div>
                <div class="w-1.5 h-full bg-slate-600"></div>
              </div>
            </div>
            <div id="silhouette-gallery" class="hidden w-full flex-col items-center">
              <div class="timber-surface w-[76%] h-3.5 rounded-xs" style="background: linear-gradient(180deg, #78716c 0%, #57534e 100%);"></div>
              <div class="w-[60%] h-8 flex justify-between px-4">
                <div class="timber-body w-6 h-full bg-stone-900"></div>
                <div class="timber-body w-6 h-full bg-stone-900"></div>
              </div>
            </div>
            <div id="silhouette-pavilion" class="hidden w-full flex-col items-center">
              <div class="w-[76%] h-3 rounded-t-md bg-slate-950 border-t border-amber-400"></div>
              <div class="w-[68%] h-8 bg-slate-950"></div>
            </div>
            <span id="furniture-caption" class="sr-only">1:10 Scale</span>
          </div>
        </div>

        <!-- Quiet Horizontal Filmstrip -->
        <div class="flex items-center gap-2 overflow-x-auto py-1 scrollbar-none">
          {showcaseSelects.map((photo, idx) => (
            <button
              type="button"
              class={`quick-swap-btn shrink-0 w-20 rounded-lg overflow-hidden border transition-all cursor-pointer ${idx === 0 ? 'border-amber-400 ring-1 ring-amber-400' : 'border-slate-800 opacity-75 hover:opacity-100'}`}
              data-id={photo.id}
              title={photo.title}
            >
              <div class="aspect-4/3 bg-black">
                <img src={withBase(photo.src)} alt={photo.title} class="w-full h-full object-cover" loading="lazy" />
              </div>
            </button>
          ))}
        </div>
      </div>

      <!-- Right 5 Columns: Ultra-Minimal Purchase Card -->
      <div class="lg:col-span-5 bg-slate-900/70 border border-slate-800/90 rounded-2xl p-6 space-y-5">
        <!-- Title & Price -->
        <div class="flex items-baseline justify-between gap-4 border-b border-slate-800/80 pb-4">
          <div class="min-w-0">
            <h2 id="store-artwork-title" class="font-kinpaku text-xl sm:text-2xl leading-snug truncate">
              {showcaseSelects[0]?.title}
            </h2>
            <span id="store-artwork-telemetry" class="text-slate-400 text-xs block truncate mt-0.5">
              Archival Signed Print · Free US Shipping
            </span>
          </div>
          <span id="calculated-price" class="font-kinpaku text-3xl shrink-0">$650</span>
        </div>

        <!-- 1. Choose Size (3 clean buttons, nothing else required) -->
        <div>
          <span class="text-xs text-slate-400 block mb-2">Size</span>
          <div class="grid grid-cols-3 gap-2">
            <button type="button" class="size-btn py-2.5 px-2 rounded-xl bg-slate-950 border border-slate-800 hover:border-amber-400 text-center cursor-pointer transition-all text-white" data-size="16x24" data-base-price="380">
              <span class="font-semibold block text-sm">16×24"</span>
              <span class="size-price-label text-xs text-slate-400 block">$380</span>
            </button>
            <button type="button" class="size-btn py-2.5 px-2 rounded-xl bg-amber-500 text-black border border-amber-400 font-bold text-center cursor-pointer" data-size="24x36" data-base-price="650">
              <span class="block text-sm">24×36"</span>
              <span class="size-price-label text-xs block">$650</span>
            </button>
            <button type="button" class="size-btn py-2.5 px-2 rounded-xl bg-slate-950 border border-slate-800 hover:border-amber-400 text-center cursor-pointer transition-all text-white" data-size="40x60" data-base-price="1450">
              <span class="font-semibold block text-sm">40×60"</span>
              <span class="size-price-label text-xs text-slate-400 block">$1450</span>
            </button>
          </div>
        </div>

        <!-- Optional Customization (Closed by default) -->
        <details class="group rounded-xl border border-slate-800/80 bg-slate-950/50">
          <summary class="px-3.5 py-2.5 cursor-pointer select-none flex items-center justify-between text-xs text-slate-300 hover:text-white">
            <span>Optional: Frame, Surface &amp; Local Pickup</span>
            <span class="text-[10px] text-slate-500 group-open:rotate-180 transition-transform">▼</span>
          </summary>

          <div class="px-3.5 pb-3.5 pt-2 border-t border-slate-800/70 space-y-3 text-xs">
            <div>
              <span class="text-[11px] text-slate-400 block mb-1">Surface</span>
              <div class="grid grid-cols-3 gap-1.5">
                {substrates.map((sub, idx) => (
                  <button
                    type="button"
                    class={`substrate-btn py-1.5 px-2 rounded-lg text-center border cursor-pointer ${idx === 0 ? 'bg-amber-500/15 border-amber-400 text-white font-bold' : 'bg-slate-900 border-slate-800 text-slate-300'}`}
                    data-id={sub.id}
                    data-name={sub.name}
                    data-desc={sub.desc}
                    data-multiplier={sub.priceMultiplier}
                  >
                    <span class="block text-[11px]">{sub.shortName}</span>
                  </button>
                ))}
              </div>
              <span id="active-substrate-desc" class="sr-only">{substrates[0].desc}</span>
            </div>

            <div>
              <span class="text-[11px] text-slate-400 block mb-1">Frame</span>
              <div class="grid grid-cols-2 gap-1.5">
                {beardsFramingProfiles.map((fp, idx) => (
                  <button
                    type="button"
                    class={`framing-btn py-1.5 px-2.5 rounded-lg text-left border cursor-pointer flex items-center justify-between ${idx === 0 ? 'bg-amber-500/15 border-amber-400 text-white font-bold' : 'bg-slate-900 border-slate-800 text-slate-300'}`}
                    data-id={fp.id}
                    data-name={fp.name}
                    data-desc={fp.desc}
                    data-addon={fp.addonPrice}
                    data-border-color={fp.frameBorder}
                    data-border-width={fp.frameWidth}
                    data-mat-bg={fp.matBg}
                    data-mat-pad={fp.matPad}
                  >
                    <span class="text-[11px] truncate">{fp.shortName}</span>
                    <span class="text-[10px] text-amber-300">{fp.addonPrice === 0 ? 'Incl' : `+$${fp.addonPrice}`}</span>
                  </button>
                ))}
              </div>
              <span id="active-framing-desc" class="sr-only">{beardsFramingProfiles[0].desc}</span>
            </div>

            <div>
              <span class="text-[11px] text-slate-400 block mb-1">Delivery</span>
              <div class="grid grid-cols-2 gap-1.5">
                {portlandFulfillmentModes.map((mode, idx) => (
                  <button
                    type="button"
                    class={`fulfillment-btn py-1.5 px-2.5 rounded-lg text-left border cursor-pointer flex items-center justify-between ${idx === 0 ? 'bg-cyan-500/15 border-cyan-400 text-white font-bold' : 'bg-slate-900 border-slate-800 text-slate-300'} ${idx === portlandFulfillmentModes.length - 1 ? 'col-span-2' : ''}`}
                    data-id={mode.id}
                    data-name={mode.name}
                    data-desc={mode.desc}
                    data-delta={mode.priceDelta}
                  >
                    <span class="text-[11px] truncate">{mode.shortName}</span>
                  </button>
                ))}
              </div>
              <span id="active-fulfillment-desc" class="sr-only">{portlandFulfillmentModes[0].desc}</span>
              <div id="beards-studio-picker" class="hidden mt-2">
                <select id="beards-studio-select" class="w-full bg-slate-950 text-slate-200 border border-slate-800 rounded-lg px-2 py-1.5 text-[11px]">
                  <option value="Beard's Framing — NW Pearl (Portland)">Beard's Framing — NW Pearl</option>
                  <option value="Beard's Framing — Lake Oswego">Beard's Framing — Lake Oswego</option>
                  <option value="John L. Scott — Lake Oswego">John L. Scott — Lake Oswego</option>
                </select>
              </div>
            </div>

            <!-- Hidden wood/texture/extra paint hooks for programmatic AI staging -->
            <div class="hidden">
              {pnwWallPaints.slice(5).map((sw) => (
                <button type="button" class="paint-swatch-btn" data-hex={sw.hex} data-brand={sw.brand} data-code={sw.code} data-name={sw.name}></button>
              ))}
              <button type="button" class="wood-btn" data-wood="walnut"></button>
              <button type="button" class="wood-btn" data-wood="oak"></button>
              <button type="button" class="wood-btn" data-wood="shousugi"></button>
              <button type="button" class="wood-btn" data-wood="titanium"></button>
              <button type="button" class="wood-btn" data-wood="concrete"></button>
              <button type="button" class="texture-btn" data-texture="eggshell"></button>
              <button type="button" class="texture-btn" data-texture="cedarslat"></button>
              <button type="button" class="texture-btn" data-texture="gallerylinen"></button>
              <button type="button" class="texture-btn" data-texture="limewash"></button>
              <button type="button" class="texture-btn" data-texture="concrete"></button>
            </div>
          </div>
        </details>

        <!-- Direct PayPal Express Checkout -->
        <div id="paypal-checkout-ledger" class="space-y-3 pt-1 transition-all rounded-xl">
          <div id="price-breakdown-summary" class="text-xs text-slate-400 truncate">
            24×36" Cotton Rag · Float Mount · Free Insured Shipping
          </div>
          <div class="hidden">
            <span id="ledger-base-print">$650</span>
            <span id="ledger-partner-addon">Included</span>
            <span id="ledger-partner-credit">$0</span>
            <span id="ledger-paint-spec">Rodda CA002</span>
          </div>

          <div id="paypal-smart-button-container" class="min-h-11"></div>

          <div class="flex items-center justify-between text-[11px] text-slate-400">
            <span>Signed Kinpaku™ 金箔 Eco-Ink (−45.8%) Certificate included</span>
            <button type="button" id="copy-partner-spec-btn" class="hover:text-amber-300 cursor-pointer">
              <span id="copy-partner-spec-label">Share</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Clean Minimal Print Grid -->
    <section class="pt-8 border-t border-slate-900 space-y-6" id="print-catalog">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <h2 class="font-kinpaku text-2xl">Collection</h2>

        <div class="flex items-center gap-1.5 overflow-x-auto scrollbar-none text-xs">
          <button type="button" class="store-filter-btn px-3 py-1 rounded-full font-bold bg-amber-500 text-black cursor-pointer shrink-0" data-filter="all">All</button>
          <button type="button" class="store-filter-btn px-3 py-1 rounded-full bg-slate-900 text-slate-300 border border-slate-800 cursor-pointer shrink-0" data-filter="wilderness">Wilderness</button>
          <button type="button" class="store-filter-btn px-3 py-1 rounded-full bg-slate-900 text-slate-300 border border-slate-800 cursor-pointer shrink-0" data-filter="water">Waters</button>
          <button type="button" class="store-filter-btn px-3 py-1 rounded-full bg-slate-900 text-slate-300 border border-slate-800 cursor-pointer shrink-0" data-filter="built">Architecture</button>
          <button type="button" class="store-filter-btn px-3 py-1 rounded-full bg-slate-900 text-slate-300 border border-slate-800 cursor-pointer shrink-0" data-filter="macro">Botanical</button>
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-5">
        {allPhotos.map((photo) => (
          <article
            class="store-catalog-card group cursor-pointer space-y-2"
            data-domain={photo.domain}
            data-diamond={photo.isCrownDiamond ? 'true' : 'false'}
            data-id={photo.id}
          >
            <button
              type="button"
              class="catalog-mount-btn w-full text-left space-y-2 cursor-pointer"
              data-id={photo.id}
            >
              <div class="aspect-3/2 bg-slate-900 rounded-xl overflow-hidden border border-slate-800 group-hover:border-amber-400/60 transition-colors">
                <img
                  src={withBase(photo.src)}
                  alt={photo.title}
                  loading="lazy"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              </div>
              <div class="flex items-center justify-between gap-2 px-0.5">
                <h3 class="text-xs sm:text-sm font-medium text-slate-200 group-hover:text-amber-300 truncate">
                  {photo.title}
                </h3>
                <span class="text-[11px] text-slate-500 shrink-0">Preview</span>
              </div>
            </button>
          </article>
        ))}
      </div>
    </section>

    <!-- Quiet Single-Line Drawer at Very Bottom for Hackathon Judges & Browser Agents -->
    <details
      id="judge-developer-drawer"
      class="rounded-xl border border-slate-900 bg-slate-950 p-4 text-xs font-mono text-slate-400"
    >
      <summary class="cursor-pointer select-none flex items-center justify-between gap-2 hover:text-slate-200">
        <span>PayPal AI Hackathon Judge &amp; WebMCP Inspector</span>
        <span id="paypal-sdk-status" class="text-[10px] text-emerald-400">Sandbox SDK Ready</span>
      </summary>

      <div id="webmcp-inspector" class="mt-4 pt-4 border-t border-slate-900 space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <button
            id="judge-simulate-capture-btn"
            type="button"
            class="py-2 px-3 rounded-lg font-bold bg-emerald-500/15 hover:bg-emerald-500/25 text-emerald-300 border border-emerald-500/40 cursor-pointer text-[11px] flex items-center justify-between"
          >
            <span>⚡ 1-Click Sandbox Capture</span>
            <span id="judge-sim-price">$650 → COA</span>
          </button>

          <div class="flex items-center gap-1.5">
            <button type="button" data-env="sandbox" class="paypal-env-btn flex-1 py-2 rounded-lg text-[10px] font-bold bg-[#0070BA] text-white cursor-pointer">Sandbox SDK</button>
            <button type="button" data-env="live" class="paypal-env-btn flex-1 py-2 rounded-lg text-[10px] font-bold bg-slate-900 text-slate-400 border border-slate-800 cursor-pointer">Live SDK</button>
          </div>

          <input
            id="ai-gemini-key-input"
            type="password"
            placeholder="Optional Gemini 3.8 API key…"
            class="bg-slate-900 border border-slate-800 rounded-lg px-3 py-2 text-[10px] text-white focus:outline-none"
          />
        </div>

        <div class="flex items-center gap-2 flex-wrap">
          <span id="webmcp-native-badge" class="text-[10px] text-emerald-400 mr-2">WebMCP (4 tools):</span>
          <button type="button" class="webmcp-test-btn px-2.5 py-1 rounded bg-slate-900 border border-slate-800 hover:border-emerald-400 text-[10px] text-slate-200 cursor-pointer" data-tool="search_fine_art_prints" data-args='{"query":"misty forest","domain":"wilderness"}'>search_fine_art_prints</button>
          <button type="button" class="webmcp-test-btn px-2.5 py-1 rounded bg-slate-900 border border-slate-800 hover:border-emerald-400 text-[10px] text-slate-200 cursor-pointer" data-tool="stage_artwork_in_room" data-args='{"room":"gallery","paint_code":"MW001","size":"40x60","substrate":"acrylic","framing":"beards-kells"}'>stage_artwork_in_room</button>
          <button type="button" class="webmcp-test-btn px-2.5 py-1 rounded bg-slate-900 border border-slate-800 hover:border-emerald-400 text-[10px] text-slate-200 cursor-pointer" data-tool="curate_room_with_ai" data-args='{"design_brief":"Calm water print for an office under $750"}'>curate_room_with_ai</button>
          <button type="button" class="webmcp-test-btn px-2.5 py-1 rounded bg-slate-900 border border-slate-800 hover:border-sky-400 text-[10px] text-slate-200 cursor-pointer" data-tool="initiate_paypal_checkout" data-args='{"buyer_note":"Gift"}'>initiate_paypal_checkout</button>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-3">
          <pre id="paypal-order-json-preview" class="p-3 rounded-lg bg-black border border-slate-900 text-[9.5px] text-emerald-300 overflow-x-auto max-h-36"></pre>
          <pre id="webmcp-execution-log" class="p-3 rounded-lg bg-black border border-slate-900 text-[9.5px] text-slate-300 overflow-x-auto max-h-36">Select a WebMCP tool above to view JSON output.</pre>
        </div>
      </div>
    </details>
  </div>

  <script is:inline id="store-catalog-json" type="application/json" set:html={JSON.stringify(allPhotos)} />
  <script src="../scripts/store-client.ts"></script>
</Layout>
