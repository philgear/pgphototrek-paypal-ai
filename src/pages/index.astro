    <section class="pt-8 border-t border-slate-800 space-y-6" id="print-catalog">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <h2 class="text-2xl sm:text-3xl font-black font-pocketgull text-white">
            Curated 300 DPI Archival Print Collection ({allPhotos.length})
          </h2>
          <p class="text-xs text-slate-400 font-mono mt-1">
            Click <strong class="text-amber-300">Mount in Room 🖼️</strong> on any work to stage it on the architectural wall and update the PayPal Orders v2 ledger.
          </p>
        </div>

        <div class="flex items-center gap-1.5 overflow-x-auto pb-1 scrollbar-none font-mono text-xs">
          <button type="button" class="store-filter-btn px-3 py-1.5 rounded-xl font-bold bg-amber-500 text-black border border-amber-400 cursor-pointer shrink-0" data-filter="all">
            All ({allPhotos.length})
          </button>
          <button type="button" class="store-filter-btn px-3 py-1.5 rounded-xl font-bold bg-slate-900 text-slate-300 border border-slate-800 cursor-pointer shrink-0" data-filter="diamonds">
            💎 Diamonds ({allPhotos.filter((p) => p.isCrownDiamond).length})
          </button>
          <button type="button" class="store-filter-btn px-3 py-1.5 rounded-xl font-bold bg-slate-900 text-slate-300 border border-slate-800 cursor-pointer shrink-0" data-filter="wilderness">
            🌲 Wilderness ({allPhotos.filter((p) => p.domain === 'wilderness').length})
          </button>
          <button type="button" class="store-filter-btn px-3 py-1.5 rounded-xl font-bold bg-slate-900 text-slate-300 border border-slate-800 cursor-pointer shrink-0" data-filter="water">
            🌊 Waters ({allPhotos.filter((p) => p.domain === 'water').length})
          </button>
          <button type="button" class="store-filter-btn px-3 py-1.5 rounded-xl font-bold bg-slate-900 text-slate-300 border border-slate-800 cursor-pointer shrink-0" data-filter="built">
            🏛️ Architecture ({allPhotos.filter((p) => p.domain === 'built').length})
          </button>
          <button type="button" class="store-filter-btn px-3 py-1.5 rounded-xl font-bold bg-slate-900 text-slate-300 border border-slate-800 cursor-pointer shrink-0" data-filter="macro">
            🌿 Botanical ({allPhotos.filter((p) => p.domain === 'macro').length})
          </button>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {allPhotos.map((photo) => (
          <article
            class="store-catalog-card group bg-slate-950/85 rounded-2xl border border-slate-800 hover:border-amber-400/60 transition-all overflow-hidden flex flex-col justify-between shadow-xl"
            data-domain={photo.domain}
            data-diamond={photo.isCrownDiamond ? 'true' : 'false'}
            data-id={photo.id}
          >
            <div>
              <div class="aspect-3/2 bg-black relative overflow-hidden">
                <img
                  src={withBase(photo.src)}
                  alt={photo.title}
                  loading="lazy"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
                <div class="absolute top-2.5 left-2.5 flex items-center gap-1.5">
                  <span class="px-2 py-0.5 rounded-md text-[9px] font-mono font-bold bg-black/80 text-amber-300 border border-amber-400/40">
                    {photo.isCrownDiamond ? `💎 J++ ${photo.score}` : `★ ${photo.score}`}
                  </span>
                </div>
              </div>

              <div class="p-4 space-y-2">
                <h3 class="text-sm font-pocketgull font-bold text-white group-hover:text-amber-300 transition-colors line-clamp-1">
                  {photo.title}
                </h3>
                <p class="text-[10px] font-mono text-slate-400 line-clamp-2">{photo.desc}</p>
                <div class="text-[9px] font-mono text-slate-500 truncate pt-1 border-t border-white/5">
                  {photo.telemetry}
                </div>
                {photo.paintPalette && photo.paintPalette.length > 0 && (
                  <div class="flex items-center gap-1.5 pt-1">
                    <span class="text-[8px] font-mono uppercase text-slate-400">Pigments:</span>
                    {photo.paintPalette.slice(0, 5).map((sw) => (
                      <span
                        class="size-3.5 rounded-full border border-white/30 inline-block"
                        style={`background-color: ${sw.hex};`}
                        title={sw.paintName}
                      ></span>
                    ))}
                  </div>
                )}
              </div>
            </div>

            <div class="p-4 pt-0">
              <button
                type="button"
                class="catalog-mount-btn w-full py-2 px-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-mono text-xs font-bold transition-all cursor-pointer flex items-center justify-center gap-1.5"
                data-id={photo.id}
              >
                <span>Mount in Room 🖼️</span>
              </button>
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>

  <script is:inline id="store-catalog-json" type="application/json" set:html={JSON.stringify(allPhotos)} />
  <script src="../scripts/store-client.ts"></script>
</Layout>
