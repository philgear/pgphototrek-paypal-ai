---
// SPDX-License-Identifier: Apache-2.0
/**
 * Alias route `/store` -> redirects cleanly to the primary Agentic Atelier & Store root
 * so judges visiting either `/` or `/store` land directly on the interactive experience.
 */
const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${base}`} />
    <title>Redirecting to Phil Gear Fine Art Store...</title>
  </head>
  <body style="background:#0f172a;color:#f8fafc;font-family:monospace;padding:2rem;">
    <p>Opening Agentic Art Concierge &amp; PayPal Orders v2 Store… <a href={base} style="color:#38bdf8;">Continue</a></p>
  </body>
</html>
