---
// SPDX-License-Identifier: Apache-2.0
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Phil Gear Photography — Fine Art Prints',
  description = 'Archival Pacific Northwest fine art prints with AI room sizing and PayPal checkout.',
} = Astro.props;

const rawBase = import.meta.env.BASE_URL || '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
---

<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth" data-theme="pebble" data-base-url={base}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <link rel="stylesheet" href={`${base}vendor/fontawesome/css/all.min.css`} />
  <style is:inline set:html={`
    @font-face {
      font-family: 'PocketGull';
      src: url('${base}fonts/PocketGull-VF.woff2') format('woff2');
      font-weight: 100 900;
      font-display: swap;
    }
    @font-face {
      font-family: 'PocketGull Mono';
      src: url('${base}fonts/PocketGullMono-Regular.woff2') format('woff2');
      font-weight: 400;
      font-display: swap;
    }
    @font-face {
      font-family: 'PocketGull Kinpaku';
      src: url('${base}fonts/PocketGull-Kinpaku.woff2') format('woff2');
      font-weight: 400 900;
      font-display: swap;
    }
    @font-face {
      font-family: 'PocketGull Kintsugi';
      src: url('${base}fonts/PocketGull-Kintsugi.woff2') format('woff2');
      font-weight: 400 700;
      font-display: swap;
    }
  `} />
</head>
<body class="bg-slate-950 text-slate-100 min-h-dvh flex flex-col font-sans antialiased selection:bg-amber-400/30 selection:text-amber-200">
  <!-- Minimal Gallery Header -->
  <header class="bg-slate-950/90 backdrop-blur-md border-b border-slate-900 sticky top-0 z-40 print:hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <nav class="flex items-center justify-between h-14 gap-4" aria-label="Gallery navigation">
        <a href={`${base}`} class="flex items-center gap-2.5 text-white">
          <img
            src={`${base}pwa-192x192.png`}
            alt="Phil Gear Photography"
            class="size-8 rounded-full border border-amber-400/60 object-cover"
          />
          <span class="font-kinpaku text-lg sm:text-xl tracking-tight leading-none">
            Phil Gear Photography
          </span>
        </a>

        <div class="flex items-center gap-5 text-xs text-slate-300">
          <a href={`${base}#print-catalog`} class="hover:text-white transition-colors">
            Collection
          </a>
          <a href={`${base}certificate/`} class="hover:text-amber-300 transition-colors">
            Authenticity
          </a>
        </div>
      </nav>
    </div>
  </header>

  <main class="flex-1 w-full">
    <slot />
  </main>

  <footer class="mt-16 border-t border-slate-900 py-8 px-4 sm:px-6 text-xs text-slate-500 print:hidden">
    <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <span class="font-kinpaku text-sm text-slate-200">PocketGull Kinpaku™ 金箔</span>
        <span>•</span>
        <span>24k Gold COLR/CPAL + −45.8% Eco-Ink</span>
      </div>
      <div class="flex items-center gap-4">
        <a href="https://www.philgearphotography.com/store" target="_blank" rel="noopener noreferrer" class="hover:text-slate-300 transition-colors">
          philgearphotography.com
        </a>
        <a href="https://github.com/philgear/pgphototrek-paypal-ai" target="_blank" rel="noopener noreferrer" class="hover:text-slate-300 transition-colors">
          GitHub
        </a>
        <a href={`${base}#judge-developer-drawer`} class="hover:text-slate-300 transition-colors">
          PayPal &amp; AI Specs
        </a>
      </div>
    </div>
  </footer>
</body>
</html>
