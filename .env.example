# Optional environment configuration for local development
# None of these are required! Out of the box, the app runs 100% zero-config:
# - PayPal defaults to the official PayPal Sandbox JS SDK (`client-id=sb`)
# - AI Interior Concierge runs Chrome Built-in AI or the 256-dim Semantic Vector Solver,
#   and upgrades to `gemini-3.8-flash` if a key is entered in the UI.

PUBLIC_PAYPAL_SANDBOX_CLIENT_ID=sb
PUBLIC_GEMINI_MODEL=gemini-3.8-flash
